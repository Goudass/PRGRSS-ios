source "https://rubygems.org"

# Capacitor wykrywa `Gemfile` z cocoapods i używa `bundle exec pod` (nie wymaga globalnego `pod`).
# Wymagany Ruby zwykle >= 2.7 (macOS: jeśli `ruby -v` jest 2.6, zainstaluj Ruby z Homebrew: `brew install ruby` i dodaj `export PATH="/opt/homebrew/opt/ruby/bin:$PATH"` do `~/.zshrc`).
gem "cocoapods", "~> 1.15"
